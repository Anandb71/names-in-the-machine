   "deceased_by_link": "SELECT DISTINCT ?p ?sw WHERE {\n  ?sw wdt:%(prop)s ?p .\n  ?p wdt:P31 wd:Q5 ; wdt:P570 ?died .\n  ?sw wdt:P31/wdt:P279* wd:Q7397 .\n}",

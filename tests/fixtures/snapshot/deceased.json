   "occupations": "SELECT DISTINCT ?occ ?occLabel WHERE {\n  VALUES ?root { %(roots)s }\n  ?occ wdt:P279* ?root .\n  SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". }\n}",

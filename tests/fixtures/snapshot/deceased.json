   "no_death_by_link": "SELECT DISTINCT ?p WHERE {\n  ?sw wdt:%(prop)s ?p .\n  ?p wdt:P31 wd:Q5 .\n  FILTER NOT EXISTS { ?p wdt:P570 ?died }\n  ?sw wdt:P31/wdt:P279* wd:Q7397 .\n}",
   "names": "SELECT ?p ?kind ?name WHERE {\n  VALUES ?p { %(qids)s }\n  VALUES ?kind { rdfs:label skos:altLabel }\n  ?p ?kind ?name .\n  FILTER(LANG(?name) IN (\"en\", \"mul\"))\n}",
   "facts": "SELECT ?p ?prop ?value ?valueLabel WHERE {\n  VALUES ?p { %(qids)s }\n  VALUES ?prop { wdt:P31 wdt:P106 }\n  ?p ?prop ?value .\n  OPTIONAL { ?value rdfs:label ?valueLabel . FILTER(LANG(?valueLabel) = \"en\") }\n}",
   "dates": "SELECT ?p ?which ?time ?precision ?rank WHERE {\n  VALUES ?p { %(qids)s }\n  VALUES (?which ?claim ?valueProp) { (\"born\" p:P569 psv:P569) (\"died\" p:P570 psv:P570) }\n  ?p ?claim ?statement .\n  ?statement wikibase:rank ?rank .\n  OPTIONAL { ?statement ?valueProp ?node . ?node wikibase:timeValue ?time ; wikibase:timePrecision ?precision . }\n}",
   "links_in": "SELECT ?p ?prop ?sw WHERE {\n  VALUES ?p { %(qids)s }\n  VALUES ?prop { wdt:P178 wdt:P170 wdt:P943 wdt:P287 wdt:P112 wdt:P61 }\n  ?sw ?prop ?p .\n}",
   "links_out": "SELECT ?p ?sw WHERE {\n  VALUES ?p { %(qids)s }\n  ?p wdt:P800 ?sw .\n}",
   "link_labels": "SELECT ?sw ?swLabel WHERE {\n  VALUES ?sw { %(qids)s }\n  ?sw rdfs:label ?swLabel . FILTER(LANG(?swLabel) = \"en\")\n}"
